<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ModOrderDesyncFix</RootNamespace>
    <!-- The game loads "<manifest id>.dll", so the assembly name must match the manifest id. -->
    <AssemblyName>ModOrderDesyncFix</AssemblyName>
    <Version>0.1.0</Version>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- sts2.dll and its dependencies are resolved from the game install; version conflicts are expected. -->
    <NoWarn>MSB3277</NoWarn>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!--
    Game install location. Override on the command line if the game lives elsewhere:
      dotnet build -p:Sts2Dir="D:\SteamLibrary\steamapps\common\Slay the Spire 2"
  -->
  <PropertyGroup>
    <Sts2Dir Condition="'$(Sts2Dir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2</Sts2Dir>
    <Sts2DataDir>$(Sts2Dir)\data_sts2_windows_x86_64</Sts2DataDir>
    <!-- Set -p:DeployToGame=true to copy the built mod into the game's mods folder. -->
    <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>
    <ModDeployDir>$(Sts2Dir)\mods\$(AssemblyName)</ModDeployDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2" HintPath="$(Sts2DataDir)\sts2.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(Sts2DataDir)\0Harmony.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(Sts2DataDir)\GodotSharp.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(AssemblyName).json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ModOrderDesyncFix.Tests" />
  </ItemGroup>

  <!--
    Release builds also produce dist\ModOrderDesyncFix-<version>.zip, holding a ModOrderDesyncFix\
    folder with the DLL and manifest. Extracting it into the game's mods folder installs the mod.
  -->
  <Target Name="ZipMod" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <!-- Set here, not at the top level: IntermediateOutputPath is only defined once the SDK targets load. -->
    <PropertyGroup>
      <DistDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'dist'))</DistDir>
      <ModStageDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'modzip'))</ModStageDir>
    </PropertyGroup>
    <RemoveDir Directories="$(ModStageDir)" />
    <Copy SourceFiles="$(TargetPath);$(OutDir)$(AssemblyName).json" DestinationFolder="$(ModStageDir)$(AssemblyName)" />
    <MakeDir Directories="$(DistDir)" />
    <ZipDirectory SourceDirectory="$(ModStageDir)" DestinationFile="$(DistDir)$(AssemblyName)-$(Version).zip" Overwrite="true" />
    <Message Importance="high" Text="Packaged $(DistDir)$(AssemblyName)-$(Version).zip" />
  </Target>

  <Target Name="DeployMod" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <MakeDir Directories="$(ModDeployDir)" />
    <Copy SourceFiles="$(TargetPath);$(OutDir)$(AssemblyName).json" DestinationFolder="$(ModDeployDir)" />
    <Message Importance="high" Text="Deployed $(AssemblyName) to $(ModDeployDir)" />
  </Target>

</Project>
